# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# machine state — never committed, always read (see ADR-0003)
.ci/
coverage/
playwright-report/
test-results/
.vite/
vite.config.ts.timestamp-*

# local
.env
.env.*
!.env.example
*.local
.DS_Store
.idea/
.vscode/

# playwright storage state
/e2e/.auth/

# jest-junit's DEFAULT output path. Every run of record steers the JUnit artefact into its own
# directory with JEST_JUNIT_OUTPUT_FILE (tools/gates/run.mjs); a hand-run without that variable
# writes this file into the cwd instead — measured 2026-11-02, and it is the "one file every run
# overwrites" defect jest.config.mjs's header names. Ignored so it can never be committed by
# accident; it is a byproduct, never an artefact any gate reads.
junit.xml
