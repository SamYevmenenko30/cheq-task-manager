# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# machine state — never committed, always read (see ADR-0003)
.ci/
coverage/
playwright-report/
test-results/
.vite/
vite.config.ts.timestamp-*

# local
.env
.env.*
!.env.example
*.local
.DS_Store
.idea/
.vscode/

# playwright storage state
/e2e/.auth/

# jest-junit's DEFAULT output path. Every run of record steers the JUnit artefact into its own
# directory with JEST_JUNIT_OUTPUT_FILE (tools/gates/run.mjs); a hand-run without that variable
# writes this file into the cwd instead — measured 2026-11-02, and it is the "one file every run
# overwrites" defect jest.config.mjs's header names. Ignored so it can never be committed by
# accident; it is a byproduct, never an artefact any gate reads.
junit.xml

# terraform. State is the only record of what exists in the account and it is NOT a source of
# truth worth committing: it is recreated by `terraform import` if lost, and committing it makes
# every apply a merge conflict. Plans are byte-for-byte snapshots of state and go with it.
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
crash.log
crash.*.log

# `.terraform.lock.hcl` is COMMITTED on purpose, and is the exception to the block above: it is the
# only record of which provider version an apply actually used — the role pnpm-lock.yaml plays for
# packages, where package.json declares a range and the lock decides (ADR-0003). Ignoring it would
# mean two applies of the same commit could use different providers.

# tfvars can hold whatever a hand typed. Nothing here needs them — every variable is either
# defaulted or passed with -var by the workflow — so one appearing is a local convenience.
*.tfvars
*.auto.tfvars
!*.tfvars.example
