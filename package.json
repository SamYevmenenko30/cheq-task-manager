{
  "name": "cheq-task-manager",
  "private": true,
  "type": "module",
  "description": "Task manager built spec-first: a vision text becomes a spec, a spec becomes red tests, red tests become code the toolchain itself has judged. The gates in tools/gates have ZERO runtime dependencies — each is Node 22 ESM — so a gate runs in a fresh worktree before an install finishes. Questions about types are delegated to tsc; no gate parses TypeScript itself. tools/gates is deliberately NOT a workspace package: a package.json there would give it dependencies and it would stop running exactly when it is needed.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.21",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "spec-gate": "node tools/gates/spec-gate.mjs",
    "red-check": "node tools/gates/red-check.mjs",
    "test-guard": "node tools/gates/test-guard.mjs",
    "gate-probes": "node tools/gates/gate-probes.mjs",
    "lights": "node tools/gates/lights/run.mjs",
    "ready": "node tools/gates/ready.mjs",
    "ready:quick": "node tools/gates/ready.mjs --quick",
    "status": "node tools/gates/status.mjs",
    "project": "node tools/gates/project.mjs",
    "digest": "node tools/gates/digest.mjs --fix",
    "digest:check": "node tools/gates/digest.mjs --check",
    "types": "node tools/gates/run.mjs types --kind all",
    "test:core": "node tools/gates/run.mjs test --kind core",
    "test:api": "node tools/gates/run.mjs test --kind api",
    "test:web": "node tools/gates/run.mjs test --kind web",
    "e2e": "node tools/gates/run.mjs e2e",
    "lint": "node tools/gates/run.mjs lint",
    "dev:web": "pnpm --filter @cheq/web exec vite",
    "dev:api": "pnpm --filter @cheq/api exec tsx watch src/index.ts"
  }
}
