{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // Every project here is noEmit: the compiler is a verdict, not a build step
    // (Vite and Vitest do the transforming). That is what lets an import keep its
    // explicit .ts/.tsx extension, which Vitest resolves and tsc would otherwise
    // reject with TS5097.
    "allowImportingTsExtensions": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
